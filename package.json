{
  "name": "@ciqol/resenv",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Replace environment references with their resolved values at application startup",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciqol/resenv.git"
  },
  "homepage": "https://github.com/ciqol/resenv#readme",
  "bugs": {
    "url": "https://github.com/ciqol/resenv/issues"
  },
  "keywords": [
    "environment",
    "dotenv",
    "secrets",
    "nx"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.mts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./resolve": {
      "types": {
        "import": "./dist/resolve.d.mts",
        "require": "./dist/resolve.d.cts",
        "default": "./dist/resolve.d.mts"
      },
      "import": "./dist/resolve.mjs",
      "require": "./dist/resolve.cjs"
    },
    "./resolve-commands": {
      "types": {
        "import": "./dist/resolve-commands.d.mts",
        "require": "./dist/resolve-commands.d.cts",
        "default": "./dist/resolve-commands.d.mts"
      },
      "import": "./dist/resolve-commands.mjs",
      "require": "./dist/resolve-commands.cjs"
    },
    "./resolve-doppler": {
      "types": {
        "import": "./dist/resolve-doppler.d.mts",
        "require": "./dist/resolve-doppler.d.cts",
        "default": "./dist/resolve-doppler.d.mts"
      },
      "import": "./dist/resolve-doppler.mjs",
      "require": "./dist/resolve-doppler.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "resenv": "dist/bin/resenv.cjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit": "npm audit --omit=dev --audit-level=high && node scripts/audit.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.spec.json",
    "bench": "node scripts/benchmark.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node --test test/*.test.mjs",
    "test:package": "node test/package-smoke.mjs",
    "test:nx": "node test/nx-interop.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test:coverage && npm run test:integration && npm run test:package",
    "release:check": "npm run verify && npm pack ./dist --dry-run",
    "pack:local": "npm pack ./dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-typescript": "12.3.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.12.0",
    "rollup": "4.63.5",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.12"
  },
  "type": "module"
}
