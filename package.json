{
  "name": "@ciqol/resenv",
  "version": "0.6.0",
  "private": true,
  "description": "Resolve secret references and encrypted values already in an application's environment",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciqol/resenv.git"
  },
  "homepage": "https://github.com/ciqol/resenv#readme",
  "bugs": {
    "url": "https://github.com/ciqol/resenv/issues"
  },
  "keywords": ["environment", "dotenv", "secrets", "nx"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.mts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./resolve": {
      "types": {
        "import": "./dist/resolve.d.mts",
        "require": "./dist/resolve.d.cts",
        "default": "./dist/resolve.d.mts"
      },
      "import": "./dist/resolve.mjs",
      "require": "./dist/resolve.cjs"
    },
    "./resolve-commands": {
      "types": {
        "import": "./dist/resolve-commands.d.mts",
        "require": "./dist/resolve-commands.d.cts",
        "default": "./dist/resolve-commands.d.mts"
      },
      "import": "./dist/resolve-commands.mjs",
      "require": "./dist/resolve-commands.cjs"
    },
    "./resolve-doppler": {
      "types": {
        "import": "./dist/resolve-doppler.d.mts",
        "require": "./dist/resolve-doppler.d.cts",
        "default": "./dist/resolve-doppler.d.mts"
      },
      "import": "./dist/resolve-doppler.mjs",
      "require": "./dist/resolve-doppler.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "resenv": "dist/bin/resenv.cjs"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:package": "node test/package-smoke.mjs",
    "test:nx": "node test/nx-interop.mjs",
    "pack:local": "npm pack ./dist --ignore-scripts"
  },
  "dependencies": {
    "eciesjs": "0.5.0"
  },
  "devDependencies": {
    "rollup": "4.63.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@ecies/ciphers": "0.2.6",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  }
}
